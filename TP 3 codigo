#include <LiquidCrystal.h>

LiquidCrystal lcd(12, 13, 5, 4, 3, A2);

int tempPin = A0;
int luzPin = A1;

int trigPin = 7;
int echoPin = 6;

int buzzer = 8;

int rojo = 9;
int verde = 10;
int azul = 11;

float temperatura;
int luz;

long duracion;
int distancia;

void setup()
{
  // SENSOR ULTRASONICO
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

  // BUZZER
  pinMode(buzzer, OUTPUT);

  // LED RGB
  pinMode(rojo, OUTPUT);
  pinMode(verde, OUTPUT);
  pinMode(azul, OUTPUT);

  // SERIAL
  Serial.begin(9600);

  // LCD
  lcd.begin(16, 2);
}

void loop()
{
  //  TEMPERATURA
 
  int lecturaTemp = analogRead(tempPin);

  float voltaje = lecturaTemp * 5.0;
  voltaje = voltaje / 1023.0;

  temperatura = (voltaje - 0.5) * 100;

 
  //  LUZ
 
  luz = analogRead(luzPin);

 
  //  DISTANCIA
 
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);

  digitalWrite(trigPin, LOW);

  duracion = pulseIn(echoPin, HIGH);

  distancia = duracion * 0.034 / 2;

 
  // APAGAR LED
 
  digitalWrite(rojo, LOW);
  digitalWrite(verde, LOW);
  digitalWrite(azul, LOW);

 
  //  TEMPERATURA ALTA
 
  if (temperatura > 39)
  {
    digitalWrite(rojo, HIGH);

    tone(buzzer, 1000);
    delay(300);
    noTone(buzzer);
  }

 
  //  PERSONA CERCA
 
  if (distancia < 100 && distancia > 50)
  {
    // AMARILLO
    digitalWrite(rojo, HIGH);
    digitalWrite(verde, HIGH);

    tone(buzzer, 800);
    delay(100);

    noTone(buzzer);
  }

 
  //  MUY CERCA
 
  if (distancia <= 50)
  {
    // ROJO
    digitalWrite(rojo, HIGH);

    tone(buzzer, 1500);
    delay(200);

    noTone(buzzer);
    delay(200);

    tone(buzzer, 1500);
    delay(200);

    noTone(buzzer);
  }

 
  //  MODO NOCTURNO
 
  if (luz < 200)
  {
    Serial.println("Modo nocturno ACTIVADO");
  }

 
  //  LCD
 
  lcd.clear();

  lcd.setCursor(0, 0);

  lcd.print("T:");
  lcd.print(temperatura);

  lcd.print(" D:");
  lcd.print(distancia);

  lcd.setCursor(0, 1);

  lcd.print("L:");
  lcd.print(luz);

 
  //  MONITOR SERIAL
 
  Serial.print("Temperatura: ");
  Serial.println(temperatura);

  Serial.print("Luz: ");
  Serial.println(luz);

  Serial.print("Distancia: ");
  Serial.println(distancia);

  Serial.println("HAY ALGUIEN");

  delay(1000);
}
